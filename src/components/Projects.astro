---
import type { Locale } from '@/data/types';
import { projects } from '@/data/projects';
import { ui } from '@/data/ui';
import Section from './Section.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const meta = ui[locale].sections.projects;
const groups = projects[locale];

const labels = locale === 'en'
  ? { work: 'FEATURED WORK', apps: 'APPS', personal: 'PERSONAL PROJECTS', shotsAvail: 'screenshots available', clickToView: 'click to view' }
  : { work: 'MISSIONS NOTABLES', apps: 'APPS', personal: 'PROJETS PERSO',  shotsAvail: 'captures disponibles', clickToView: 'cliquer pour voir' };

// Display order: Apps first (consistent with the Experience section), then
// featured work, then personal projects. Numbers are computed from this order
// so they always match what's shown, whatever the data order is.
let counter = 0;
const sections = [
  { label: labels.apps, items: groups.apps },
  { label: labels.work, items: groups.work },
  { label: labels.personal, items: groups.personal },
].map((g) => ({
  label: g.label,
  items: g.items.map((p) => ({ p, num: `[${String(++counter).padStart(2, '0')}]` })),
}));
---

<Section id="projects" num="04" meta={meta}>
  <div class="proj-block">
    {
      sections.map((group) => (
        <>
          <div class="proj-subhead">
            <span class="proj-subhead-marker">▸</span>
            <span class="proj-subhead-label">{group.label}</span>
            <span class="proj-subhead-rule"></span>
          </div>

          {group.items.map(({ p, num }) => {
            const hasShots = !!(p.screenshots && p.screenshots.length > 0);
            return (
            <article
              class={`proj ${hasShots ? 'has-shots' : ''}`}
              data-project={p.id}
              data-shots={hasShots ? 'true' : undefined}
              data-screenshots={hasShots ? JSON.stringify(p.screenshots) : undefined}
              data-project-title={hasShots ? p.title : undefined}
              tabindex={hasShots ? 0 : undefined}
              role={hasShots ? 'button' : undefined}
              aria-label={hasShots ? `${labels.clickToView} ${p.title}` : undefined}
            >
              <span class="proj-cmd-tag">cat {p.id}.md</span>
              <div class="proj-head">
                <div class="proj-title">
                  <span class="num">{num}</span>
                  {p.title}
                </div>
                <div class="proj-meta">
                  <span class="stack">{p.stack}</span>
                  <span class="sep">·</span>
                  <span>{p.meta}</span>
                </div>
              </div>
              <p class="proj-desc">{p.description}</p>
              {p.features && (
                <ul class="proj-feats">
                  {p.features.map((f) => <li>{f}</li>)}
                </ul>
              )}
              {p.links?.map((l) => (
                <a class="proj-link" href={l.url} rel="noopener" target="_blank">
                  {l.label}
                </a>
              ))}
              {hasShots && (
                <div class="proj-shots-bar" aria-hidden="true">
                  <span class="proj-shots-bar-left">&gt; {p.screenshots!.length} {labels.shotsAvail}</span>
                  <span class="proj-shots-bar-right">{labels.clickToView} <span class="proj-shots-bar-arrow">▸</span></span>
                </div>
              )}
            </article>
          );})}
        </>
      ))
    }
  </div>
</Section>
